page 2 (
    name: Employees
    alias: EMPLOYEES
    title: Employees
    pageGroup: @training
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    region title-bar (
        name: Employees
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )
    region employees (
        name: Employees
        type: interactiveReport
        actionsMenu {
            chart: false
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.ID,e.EMPLOYEE_NUMBER,e.FIRST_NAME||' '||e.LAST_NAME as EMPLOYEE_NAME,d.DEPARTMENT_NAME,e.EMAIL,e.HIRE_DATE,e.STATUS from DEMO_TRN_EMPLOYEES e join DEMO_TRN_DEPARTMENTS d on d.ID=e.DEPARTMENT_ID
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No records match your search.
        }
        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )
        column EMPLOYEE_NUMBER (
            type: plainText
            heading {
                heading: Employee number
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments:
                    ```
                    Display Label: Employee number; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column EMPLOYEE_NAME (
            type: link
            heading {
                heading: Employee
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            link {
                target: {
                    page: 11
                    clearCache: 11
                    items: {
                        P11_ID: #ID#
                    }
                }
                linkText: #EMPLOYEE_NAME#
            }
            comments {
                comments:
                    ```
                    Display Label: Employee; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: Yes; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column DEPARTMENT_NAME (
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments:
                    ```
                    Display Label: Department; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column EMAIL (
            type: plainText
            heading {
                heading: Email
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments:
                    ```
                    Display Label: Email; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column HIRE_DATE (
            type: plainText
            heading {
                heading: Joined
            }
            layout {
                sequence: 60
            }
            source {
                dataType: DATE
            }
            appearance {
                formatMask: DD Mon YYYY
            }
            comments {
                comments:
                    ```
                    Display Label: Joined; Display in Report: Yes; Display in Form: No; Format Mask: DD Mon YYYY; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            comments {
                comments:
                    ```
                    Display Label: Status; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }
            displayColumn EMPLOYEE_NUMBER (
                sequence: 20
            )
            displayColumn EMPLOYEE_NAME (
                sequence: 30
            )
            displayColumn DEPARTMENT_NAME (
                sequence: 40
            )
            displayColumn EMAIL (
                sequence: 50
            )
            displayColumn HIRE_DATE (
                sequence: 60
            )
            displayColumn STATUS (
                sequence: 70
            )
        )
    )
    button create-record (
        buttonName: CREATE
        label: Add employee
        layout {
            sequence: 10
            region: @title-bar
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            hot: true
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
        }
    )
)
