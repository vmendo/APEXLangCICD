page 12 (
    name: Course
    alias: COURSE
    title: Course
    appearance {
        pageMode: normal
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Course
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    region course (
        name: Course Details
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: DEMO_TRN_COURSES
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
    )

    region buttons (
        name: Actions
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )
    pageItem P12_ID (
        type: hidden
        settings {
            valueProtected: true
        }
        layout {
            sequence: 10
            region: @course
            slot: regionBody
        }
        source {
            formRegion: @course
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    pageItem P12_CATEGORY_ID (
        type: selectList
        label {
            label: Category
        }
        lov {
            type: sharedComponent
            lov: @categories
            displayNullValue: true
            nullDisplayValue: Select an option
        }
        layout {
            sequence: 20
            region: @course
            slot: regionBody
        }
        appearance {
            template: @/required-floating
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @course
            column: CATEGORY_ID
            dataType: number
        }
    )
    pageItem P12_COURSE_CODE (
        type: textField
        settings {
            trimSpaces: leadingAndTrailing
        }
        label {
            label: Course Code
        }
        layout {
            sequence: 30
            region: @course
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            width: 50
        }
        validation {
            valueRequired: true
            maxLength: 20
        }
        source {
            formRegion: @course
            column: COURSE_CODE
            dataType: varchar2
        }
    )
    pageItem P12_COURSE_NAME (
        type: textField
        settings {
            trimSpaces: leadingAndTrailing
        }
        label {
            label: Course Name
        }
        layout {
            sequence: 40
            region: @course
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            width: 50
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @course
            column: COURSE_NAME
            dataType: varchar2
        }
    )
    pageItem P12_DESCRIPTION (
        type: textarea
        settings {
            resizable: true
            charCounter: true
        }
        label {
            label: Learning Objectives
        }
        layout {
            sequence: 50
            region: @course
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            width: 50
            height: 4
        }
        validation {
            valueRequired: false
            maxLength: 1000
        }
        source {
            formRegion: @course
            column: DESCRIPTION
            dataType: varchar2
        }
    )
    pageItem P12_DURATION_HOURS (
        type: numberField
        settings {
            minValue: 0.1
            maxValue: 80
        }
        label {
            label: Duration Hours
        }
        layout {
            sequence: 60
            region: @course
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            width: 50
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @course
            column: DURATION_HOURS
            dataType: number
        }
    )
    pageItem P12_COURSE_FEE (
        type: numberField
        settings {
            minValue: 0
        }
        label {
            label: Course Fee EUR
        }
        layout {
            sequence: 70
            region: @course
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            width: 50
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @course
            column: COURSE_FEE
            dataType: number
        }
        default {
            type: static
            staticValue: 0
        }
    )
    pageItem P12_STATUS (
        type: selectList
        label {
            label: Status
        }
        lov {
            type: sharedComponent
            lov: @course-status
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @course
            slot: regionBody
        }
        appearance {
            template: @/required-floating
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @course
            column: STATUS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: ACTIVE
        }
    )
    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
                clearCache: 12
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )
    button create (
        buttonName: CREATE
        label: Create Course
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
        behavior {
            action: submitPage
            databaseAction: insert
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P12_ID
        }
    )
    button save (
        buttonName: SAVE
        label: Save Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
        behavior {
            action: submitPage
            databaseAction: update
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_ID
        }
    )
    button delete (
        buttonName: DELETE
        label: Delete Course
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: submitPage
            databaseAction: delete
            warnOnUnsavedChanges: doNotCheck
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Delete this course? Related records may prevent deletion.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_ID
        }
    )
    process initialize-course (
        name: Initialize Course
        type: formInitialization
        formRegion: @course
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process save-course (
        name: Process Course
        type: formAutoRowProcessing
        formRegion: @course
        execution {
            sequence: 10
            point: processing
        }
        target {
            targetType: regionSource
            preventLostUpdates: true
            returnPksAfterInsert: true
        }
        successMessage {
            successMessage: Course changes saved.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    branch (
        name: Return to Course Report
        execution {
            sequence: 20
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 3
                clearCache: 12
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )
)
