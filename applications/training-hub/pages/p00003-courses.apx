page 3 (
    name: Courses
    alias: COURSES
    title: Courses
    pageGroup: @training
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    region title-bar (
        name: Courses
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )
    region courses (
        name: Course catalog
        type: interactiveReport
        actionsMenu {
            chart: false
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.ID,c.COURSE_CODE,c.COURSE_NAME,k.CATEGORY_NAME,c.DESCRIPTION,c.DURATION_HOURS,c.COURSE_FEE,c.STATUS from DEMO_TRN_COURSES c join DEMO_TRN_CATEGORIES k on k.ID=c.CATEGORY_ID
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No records match your search.
        }
        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )
        column COURSE_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments:
                    ```
                    Display Label: Code; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column COURSE_NAME (
            type: link
            heading {
                heading: Course
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            link {
                target: {
                    page: 12
                    clearCache: 12
                    items: {
                        P12_ID: #ID#
                    }
                }
                linkText: #COURSE_NAME#
            }
            comments {
                comments:
                    ```
                    Display Label: Course; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: Yes; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column CATEGORY_NAME (
            type: plainText
            heading {
                heading: Category
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments:
                    ```
                    Display Label: Category; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments:
                    ```
                    Display Label: Description; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column DURATION_HOURS (
            type: plainText
            heading {
                heading: Hours
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments:
                    ```
                    Display Label: Hours; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column COURSE_FEE (
            type: plainText
            heading {
                heading: Fee EUR
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments:
                    ```
                    Display Label: Fee (EUR); Display in Report: Yes; Display in Form: No; Format Mask: FM999G990D00; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            comments {
                comments:
                    ```
                    Display Label: Status; Display in Report: Yes; Display in Form: No; Format Mask: none; Value Required: No; Read Only: Yes; Primary Display Column: No; Authorization Scheme: authenticated application.
                    ```
            }
        )
        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }
            displayColumn COURSE_CODE (
                sequence: 20
            )
            displayColumn COURSE_NAME (
                sequence: 30
            )
            displayColumn CATEGORY_NAME (
                sequence: 40
            )
            displayColumn DESCRIPTION (
                sequence: 50
            )
            displayColumn DURATION_HOURS (
                sequence: 60
            )
            displayColumn COURSE_FEE (
                sequence: 70
            )
            displayColumn STATUS (
                sequence: 80
            )
        )
    )
    button create-record (
        buttonName: CREATE
        label: Add course
        layout {
            sequence: 10
            region: @title-bar
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            hot: true
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                clearCache: 12
            }
        }
    )
)
