    {
      "name": "DEMO_TRN_COURSES",
      "description": "Reusable training catalog with duration and per-person fee.",
      "sequence": "DEMO_TRN_COURSES_SEQ",
      "columns": [
        {
          "name": "ID",
          "type": "NUMBER",
          "nullable": false,
          "default": "DEMO_TRN_COURSES_SEQ.NEXTVAL",
          "description": "Stable row identifier; defaults from a named training sequence."
        },
        {
          "name": "CATEGORY_ID",
          "type": "NUMBER",
          "nullable": false,
          "description": "Catalog category."
        },
        {
          "name": "COURSE_CODE",
          "type": "VARCHAR2(20)",
          "nullable": false,
          "description": "Unique catalog reference."
        },
        {
          "name": "COURSE_NAME",
          "type": "VARCHAR2(200)",
          "nullable": false,
          "description": "Catalog display title."
        },
        {
          "name": "DESCRIPTION",
          "type": "VARCHAR2(1000)",
          "nullable": true,
          "description": "Learning objectives."
        },
        {
          "name": "DURATION_HOURS",
          "type": "NUMBER(4,1)",
          "nullable": false,
          "description": "Instructional hours."
        },
        {
          "name": "COURSE_FEE",
          "type": "NUMBER(10,2)",
          "nullable": false,
          "description": "Per-person course fee in EUR.",
          "default": "0"
        },
        {
          "name": "STATUS",
          "type": "VARCHAR2(20)",
          "nullable": false,
          "description": "Catalog lifecycle state.",
          "default": "'ACTIVE'"
        }
      ],
      "pk": [
        "ID"
      ],
      "uniques": [
        [
          "COURSE_CODE"
        ]
      ],
      "checks": [
        {
          "name": "DURATION_CK",
          "expression": "DURATION_HOURS > 0 AND DURATION_HOURS <= 80"
        },
        {
          "name": "FEE_CK",
          "expression": "COURSE_FEE >= 0"
        },
        {
          "name": "STATUS_CK",
          "expression": "STATUS IN ('ACTIVE','RETIRED')"
        }
      ],
      "fks": [
        {
          "columns": [
