# Copy to config/local.env and adjust non-secret settings before project creation.
DB_CONNECT_DEV=ADB_LOCAL_DEMO
DB_CONNECT_ADMIN=ADMIN_ADBFREE
DB_CONNECT_PRO=DEMO_ADBFREE
SCHEMA_NAME=DEMO
SCHEMA_NAME_PRO=DEMO
APEX_WORKSPACE_DEV=DEMO
APEX_WORKSPACE_PRO=DEMO
APEX_APP_ID=110
# Try the source application ID first; choose the next free ID if occupied.
APEX_APP_ID_PRO_PREFERRED=${APEX_APP_ID}
# APEX_APP_ID_PRO is resolved and retained in the active project state.
# Required: set your own disposable delivery repository (owner/repo).
# Example: GITHUB_REPO=your-account/your-demo-repo
GITHUB_REPO=
PROJECT_BRANCH=main
RELEASE_TAG_PREFIX=v
# For a later rehearsal without deleting remote history, choose a new branch
# and tag prefix before creating the next project.
# PROJECT_BRANCH=codex/rehearsal-2
# RELEASE_TAG_PREFIX=rehearsal-2-v
SQLCL_TIMEOUT=180

# Check release PR status while create_release.sh waits for manual merge.
PR_POLL_SECONDS=5

# Full database + native APEXlang imports can exceed the normal stage timeout.
SQLCL_DEPLOY_TIMEOUT=1800
